# Google Gemini API Key (server-side only)
GEMINI_API_KEY=

# Klucz katalogu ujęć do sejfu — wystarczy jeden z dwóch, aplikacja pyta tego,
# który ma klucz (Pexels ma pierwszeństwo, bo lepiej filtruje pion).
#
# PIXABAY_API_KEY: darmowy, klucz widać od razu po zalogowaniu na
# pixabay.com/api/docs/ (górny blok „your API key"). Limit 100 żądań na minutę.
# PEXELS_API_KEY: od 2026 wydawanie nowych kluczy jest wstrzymane — jeśli masz
# klucz z wcześniejszych dni, działa nadal.
#
# Oba wyłącznie server-side: trafiają do żądania katalogu i nigdy do UI.
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Na którym adresie i porcie nasłuchiwać serwer.
# Domyślnie tylko localhost — wpisz 0.0.0.0, żeby otworzyć aplikację na
# sieć lokalną (np. telefon). Uwaga: API nie ma uwierzytelnienia, więc
# 0.0.0.0 wystawia kosztowne endpointy AI każdemu w sieci.
HOST=127.0.0.1
PORT=3000

# Dozwolone źródła cross-origin, po przecinku. Domyślnie puste = brak CORS
# (UI jest obsługiwane z tego samego adresu, więc CORS nie jest mu potrzebny).
# Przykład: ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=
